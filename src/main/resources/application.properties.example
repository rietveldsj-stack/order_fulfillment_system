spring.application.name=order_fulfillment
server.port=8081

# MySQL Database Connection
spring.datasource.url=jdbc:mysql://localhost:3306/order_fulfillment
spring.datasource.username=your_db_user
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update

jwt.expiration=86400000
# Generate your own, e.g. openssl rand -base64 64
jwt.secret=replace_me_with_a_base64_encoded_256_bit_secret

# rabbitMQ setup
spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.username=guest
spring.rabbitmq.password=guest

# Don't requeue a message whose listener threw - otherwise a poison
# message is redelivered in a tight loop forever.
spring.rabbitmq.listener.simple.default-requeue-rejected=false
